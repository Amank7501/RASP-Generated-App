# CORS_ALLOWED_ORIGINS: comma separated list of origins that are allowed to access the backend
CORS_ALLOWED_ORIGINS=*
# CLIENT_ID: client id of the keycloak client
CLIENT_ID=myClient
# CLIENT_SECRET: client secret of the keycloak client
CLIENT_SECRET=Gzq94saPsL1ukWy1th88MmrRN4bgl0qt
# KEYCLOAK_SERVER_URL: url of the keycloak server
KEYCLOAK_SERVER_URL=http://localhost:4000
# REALM: realm of the keycloak client
REALM=myRealm
